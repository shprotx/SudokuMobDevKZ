    <target android:name="hero_group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:duration="580"
                        android:valueFrom="0"
                        android:valueTo="0"/>
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:duration="580"
                        android:valueFrom="0"
                        android:valueTo="0"/>
                </set>
                <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:duration="240"
                        android:valueFrom="0"
                        android:valueTo="1"
                        android:interpolator="@android:interpolator/overshoot"/>
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:duration="240"
                        android:valueFrom="0"
                        android:valueTo="1"
                        android:interpolator="@android:interpolator/overshoot"/>
